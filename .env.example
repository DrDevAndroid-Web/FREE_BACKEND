# Copiar a .env y rellenar los valores reales
# NUNCA subir .env a git

PORT=3001
NODE_ENV=development

# Supabase — usar SOLO service_role key en backend, nunca anon key
SUPABASE_URL=https://PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# CORS — orígenes permitidos separados por coma
# En producción: solo dominios VersaBold
CORS_ORIGINS=http://localhost:5173,https://versabold.com

# Clave secreta para endpoints de escritura (admin)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=CAMBIAR_POR_CLAVE_ALEATORIA_32_BYTES
